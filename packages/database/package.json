{
	"name": "@repo/database",
	"version": "1.0.0",
	"main": "./src/client.ts",
	"types": "./src/client.ts",
	"exports": {
		".": {
			"types": {
				"import": "./src/client.ts",
				"require": "./src/client.ts",
				"default": "./src/client.ts"
			},
			"import": "./dist/client.js",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsup src/client.ts --format cjs --dts --sourcemap --clean",
		"dev": "tsup src/client.ts --format cjs --dts --sourcemap --watch",
		"generate": "prisma generate",
		"lint": "eslint ."
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "latest",
		"@prisma/client-runtime-utils": "7.2.0",
		"dotenv": "^17.2.3",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@repo/eslint-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/pg": "^8.16.0",
		"eslint": "^9.31.0",
		"prisma": "latest",
		"rimraf": "^5.0.5",
		"tsup": "^8.0.2",
		"tsx": "4.21.0",
		"typescript": "5.5.4"
	}
}
