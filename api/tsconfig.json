{
	"compilerOptions": {
		"module": "commonjs",
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"target": "ES2021",
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "../",
		"incremental": true,
		"skipLibCheck": true,
		"strictNullChecks": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"strict": true,
		"strictBindCallApply": false,
		"noFallthroughCasesInSwitch": false,
		"paths": {
			"@*": ["./src/*"],
			"@modules/*": ["./src/_modules/*"],
			"@decorators/*": ["./src/_decorators/*"],
			"@interfaces/*": ["./src/_interfaces/*"],
			"@shared/*": ["../shared/src/*"]
		}
	},
	"include": ["src/**/*", "../shared/src/**/*"]
}
